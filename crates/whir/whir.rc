// Icon + version info. Compiled by build.rs with the Windows SDK's rc.exe.
// (No #includes: works without the SDK include paths being set up.)

1 ICON "whir.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "whir"
            VALUE "FileDescription", "whir"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "whir"
            VALUE "OriginalFilename", "whir.exe"
            VALUE "ProductName", "whir"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
